# wpa_supplicant 2.11 build configuration for the MMI (QNX 6, SH-4), phase 6.
# WPA/WPA2-PSK only: no EAP, WPS, P2P, PMF or roaming. The station driver
# is devn-mv8688sta.so (driver_mv8688.c), EAPOL goes over BPF
# (l2_packet_qnx.c), and random bytes come from the local EGD service
# (os_random_egd.c, enabled by CONFIG_QNX). See wifi-sta/wpa/build-wpa.sh.
CONFIG_QNX=y
CONFIG_DRIVER_MV8688=y
CONFIG_L2_PACKET=qnx
CONFIG_TLS=internal
CONFIG_CRYPTO=internal
CONFIG_INTERNAL_LIBTOMMATH=y
CONFIG_NO_RANDOM_POOL=y
CONFIG_CTRL_IFACE=unix
CONFIG_BACKEND=file
CONFIG_DEBUG_FILE=y
CONFIG_NO_CONFIG_BLOBS=y
CONFIG_NO_GITVER=y
CONFIG_NO_ROAMING=y
CONFIG_NO_RRM=y
CONFIG_NO_WMM_AC=y
CONFIG_NO_ROBUST_AV=y
CONFIG_NO_VLAN=y
